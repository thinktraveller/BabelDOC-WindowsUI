# BabelDOC 本地翻译工作台 —— 开发与验证用凭据模板
#
# 用法：把本文件复制为仓库根目录的 .env，再填入真实值。
#   Copy-Item env.example .env
#
# 约定（见 project-docs/project-plan.md「API 凭据与 .env 约定」）：
#   - .env 已被 .gitignore 忽略，只存在于本机，不得提交、不得打进交付物。
#   - 读取优先级：进程环境变量 > .env。终端里已设置的变量不会被本文件覆盖。
#   - .env 只用于开发与验证；打包后的正式方案使用 Windows 凭据存储。
#   - 本文件只放变量名与占位符，不要写入任何真实 Key。

# --- OpenAI-compatible 服务配置（真实翻译必填）---

# 服务地址，例如 https://api.example.com/v1
BABELDOC_BASE_URL=https://api.example.com/v1

# 模型名，例如 gpt-4o-mini
BABELDOC_MODEL=

# API Key；只在 .env 中保存，不要提交、不要放进任务与日志
BABELDOC_API_KEY=

# --- 冒烟脚本（desktop/tests/smoke_engine.py）可选默认值 ---

BABELDOC_LANG_IN=en
BABELDOC_LANG_OUT=zh

# 默认输入 PDF 路径（留空则自动生成不含正文的样例，仅适合流程自检）
BABELDOC_SMOKE_INPUT=

# 默认输出目录
BABELDOC_SMOKE_OUTPUT=.tmp/smoke
